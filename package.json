{
  "name": "kaelor",
  "version": "1.0.0",
  "description": "Kaelor",
  "author": "Pierre Nicolas <tenzin50@hotmail.fr",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierre50/RTS-game.git"
  },
  "scripts": {
    "clean": "rimraf build",
    "dev": "webpack serve --mode development",
    "start": "pnpm dev",
    "electron:dev": "concurrently -k -n webpack,electron \"pnpm dev\" \"wait-on tcp:8080 && env -u ELECTRON_RUN_AS_NODE ELECTRON_START_URL=http://localhost:8080 electron .\"",
    "build": "pnpm clean && webpack --mode production",
    "build:dev": "pnpm clean && webpack --mode development",
    "dist": "pnpm build && electron-builder",
    "compile": "pnpm dist",
    "deploy": "pnpm build && gh-pages -d build",
    "maps:generate": "node tools/generate-maps.cjs",
    "interiors:generate": "node tools/generate-interior-maps.cjs",
    "assets:lpc:build": "python3 scripts/lpc/export_runtime_palettes.py && python3 scripts/lpc/build.py && python3 scripts/lpc/build_equipment.py && python3 scripts/lpc/build_hero_appearance.py && python3 scripts/lpc/build_animals.py",
    "assets:lpc:export-palettes": "python3 scripts/lpc/export_runtime_palettes.py",
    "assets:lpc:build-equipment": "python3 scripts/lpc/build_equipment.py",
    "assets:lpc:build-hero-appearance": "python3 scripts/lpc/build_hero_appearance.py",
    "assets:lpc:build-animals": "python3 scripts/lpc/build_animals.py",
    "assets:lpc:build-arrow-projectiles": "python3 scripts/lpc/build_arrow_projectiles.py",
    "format": "prettier --write \"app/**/*.{ts,css}\" \"*.{js,json}\"",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "duplication": "jscpd app --pattern \"**/*.ts\" --ignore \"**/*.d.ts\" --min-lines 8 --min-tokens 80",
    "architecture": "madge app --extensions ts --ts-config tsconfig.json --circular || true",
    "architecture:json": "madge app --extensions ts --ts-config tsconfig.json --circular --json",
    "check:quick": "pnpm typecheck && pnpm lint && pnpm deadcode && pnpm audit:report",
    "check": "pnpm check:quick && pnpm test",
    "audit:code": "pnpm lint && pnpm typecheck && pnpm duplication && pnpm deadcode",
    "audit:report": "node tools/audit-report.cjs",
    "precommit": "lint-staged",
    "lint": "eslint \"app/**/*.ts\""
  },
  "build": {
    "appId": "com.pierre50.dawn-of-empires",
    "mac": {
      "icon": "assets/icon.icns",
      "category": "your.app.category.type"
    },
    "asar": true,
    "asarUnpack": [
      "build/assets/**/*",
      "build/maps/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      {
        "from": "build",
        "to": "build",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "lz-string": "^1.5.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.4",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.4",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.39.4",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.7",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "3.6.2",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0",
    "webpack": "^5.107.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "plugins": [
    "prettier"
  ],
  "lint-staged": {
    "*.{js,ts,json}": [
      "prettier --write --single-quote",
      "git add"
    ]
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
